---
// src/pages/index.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Home | Syukri Solihin">
	
	<!-- This is the content that will be placed in the <slot /> of our MainLayout -->
	<div class="max-w-2xl mx-auto text-center p-8">
		
		<h1 class="font-heading text-5xl md:text-7xl">Syukri Solihin</h1>
		
		<h2 class="font-body text-base md:text-lg text-accent-blue font-normal tracking-widest uppercase mt-2 mb-8">
			Creative Developer
		</h2>
		
		<p class="text-base text-text-secondary max-w-xl mx-auto mb-10">
			A detail-oriented Creative Developer with a foundation in Computer Science and a passion for building clean, user-friendly applications. I blend full-stack development experience, showcased in projects from mobile apps to deepfake detection platforms, with a sharp eye for visual detail to create interfaces that are both robust and engaging.
		</p>

		<!-- This content is now in the footer, but we can keep a prominent CTA here -->
		<a href="/contact" class="bg-accent-blue text-bg-primary font-bold py-3 px-8 rounded-full hover:bg-opacity-80 transition-all duration-300">
			Get In Touch
		</a>
	</div>

</MainLayout>