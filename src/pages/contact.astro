---
// src/pages/contact.astro
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact | Syukri Solihin">
    <div class="max-w-3xl mx-auto p-8 text-center">
        
        <h1 class="font-heading text-5xl md:text-6xl mb-4">Get In Touch</h1>
        
        <p class="text-lg text-text-secondary max-w-xl mx-auto mb-10">
            I'm currently seeking new opportunities and I'm always open to discussing new projects or creative ideas. Whether you have a question or just want to say hi, feel free to reach out.
        </p>

        <a 
            href="mailto:syukrisolihin18@gmail.com" 
            class="inline-block bg-accent-blue text-bg-primary font-bold text-lg py-4 px-10 rounded-full hover:bg-opacity-80 transition-all duration-300"
        >
            Say Hello
        </a>

        <div class="mt-16">
            <p class="text-text-secondary mb-4">Find me on other platforms:</p>
            <div class="flex items-center justify-center space-x-8">
                <a href="https://github.com/syukrisolihin" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-accent-blue transition-colors duration-300 relative group">
                    GitHub
                    <span class="absolute -bottom-1.5 left-0 w-full h-0.5 bg-accent-amber transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
                </a>
                <a href="https://www.linkedin.com/in/syukrisolihin" target="_blank" rel="noopener noreferrer" class="font-bold hover:text-accent-blue transition-colors duration-300 relative group">
                    LinkedIn
                    <span class="absolute -bottom-1.5 left-0 w-full h-0.5 bg-accent-amber transform scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-center"></span>
                </a>
            </div>
        </div>
    </div>
</MainLayout>